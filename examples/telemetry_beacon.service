[Unit]
Description=Reticulum Telemetry Beacon
After=network.target rnsd.service
Requires=rnsd.service

[Service]
Type=simple
User=gregg
# Edit the coordinates, name, collector, and interval below.
# To find a collector hash for meshmap.reticulum.network, connect
# with Sideband on any device and check the telemetry collector
# address under Settings → Telemetry.
# Config is loaded automatically from ~/.reticulum/telemetry_beacon.conf
# See examples/telemetry_beacon.conf for the format.
ExecStart=/home/gregg/.venv/bin/sx1262-telemetry-beacon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
